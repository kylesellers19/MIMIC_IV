# ---------------------------------------------------------------------------
# CREDENTIALED DATA — never commit. PhysioNet MIMIC-IV is access-controlled
# patient data and must not land in version control under any circumstance.
# ---------------------------------------------------------------------------
data/
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# Prototyping data (open-access MIMIC demos) — keep out of git too
test files/
*.zip

# DuckDB database files (may contain materialized patient data)
*.duckdb
*.duckdb.wal
*.db

# Raw / derived data formats, wherever they land
*.csv
# Every CSV stays ignored, diagnostics included. Aggregate diagnostics are re-expressed as
# counts-only JSON under docs/run_*/results/ (see scripts/run1110_diagnostics_json.py).
*.csv.gz
*.parquet

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.python-version

# OS / editor
.DS_Store
.vscode/
.idea/

# Run logs and fitted models (credentialed derivatives) — never commit
logs/
models/
